{
  "name": "theminimarket",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta estilo Eleventa 100% Local y Offline",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron electron/main.cjs",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "start": "node electron/launcher.cjs",
    "build:exe": "npm run build:vite && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.theminimarket.pos",
    "productName": "TheMiniMarket POS",
    "directories": {
      "output": "instalador"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/minimarket.db",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "database/minimarket.db",
        "to": "database/minimarket.db"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "TheMiniMarket-POS-Portable.exe"
    }
  },
  "keywords": [
    "pos",
    "punto-de-venta",
    "eleventa",
    "electron",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
